# TapBot — the momentum agent that taps as a public TapFlow leader.
# Read-only signal checks (npm run signal) need none of this.

# TapBot's own funded Shannon key (STT for gas + tUSDC to tap). Required to trade.
AGENT_PRIVATE_KEY=0x...
AGENT_LABEL=TapBot

# Strategy
AGENT_ASSET=BTC            # BTC | ETH
AGENT_CADENCE_SEC=300      # window length to trade (300=5m, 900=15m, 3600=1h)
AGENT_STAKE_USDC=2
AGENT_INTERVAL_MS=20000    # decision cadence
AGENT_MOMENTUM_BPS=5       # min move (bps) before it acts
AGENT_MIN_LEFT_SEC=40
AGENT_DRY_RUN=false        # true = decide + log, place nothing

# Publish the rationale feed to the F4 indexer, and broadcast for followers.
TAPFLOW_API=http://localhost:8787
FEED_SECRET=
# ROUTER_ADDRESS=0x...     # from contracts/deployments.json, enables in-block mirror

# Network (defaults are Shannon)
# RPC_URL=https://dream-rpc.somnia.network
# VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
