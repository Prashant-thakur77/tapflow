# TapBot — the momentum agent that taps as a public TapFlow leader.
# Read-only signal checks (npm run signal) need none of this.

# TapBot's own funded Shannon key (STT for gas + tUSDC to tap). Required to trade.
AGENT_PRIVATE_KEY=0x...
AGENT_LABEL=TapBot

# Strategy
AGENT_ASSET=auto           # auto = BTC or ETH, whichever has a live window and the best edge | BTC | ETH
AGENT_CADENCE_SEC=auto     # auto = shortest live cadence | 300=5m, 900=15m, 3600=1h, 14400=4h, 86400=24h

# Risk gate (every "no" is published to the feed with its reason code)
AGENT_MAX_PRICE=0.90       # never pay more than 90¢ per share
AGENT_MIN_EDGE_PTS=2       # momentum tilt minus half-spread must clear this, in points
AGENT_TILT_PER_BPS=1       # tilt points per basis point of spot move (capped by AGENT_MAX_TILT_PTS=25)
AGENT_COOLDOWN_SEC=300     # seconds between taps on the same asset
AGENT_MAX_WINDOW_USDC=3    # max tUSDC at risk on one window
AUTO_CLAIM=true            # sweep settled winnings every loop (redeemMany)
AGENT_HOLD_HEARTBEAT_MS=600000
AGENT_STAKE_USDC=2
AGENT_INTERVAL_MS=20000    # decision cadence
AGENT_MOMENTUM_BPS=5       # min move (bps) before it acts
AGENT_MIN_LEFT_SEC=40
AGENT_DRY_RUN=false        # true = decide + log, place nothing

# Publish the rationale feed to the F4 indexer, and broadcast for followers.
TAPFLOW_API=http://localhost:8787
FEED_SECRET=
# ROUTER_ADDRESS=0x...     # from contracts/deployments.json, enables in-block mirror

# Network (defaults are Shannon)
# RPC_URL=https://dream-rpc.somnia.network
# VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
