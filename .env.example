# ── Browser (Vite) — all optional, sensible Shannon defaults are built in ──
# VITE_RPC_URL=https://dream-rpc.somnia.network
# VITE_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# VITE_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# VITE_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# WalletConnect project id (free, cloud.reown.com). Without it the app connects
# only to an injected wallet, which means the Connect button cannot work inside
# a Telegram mini-app — Telegram's webview injects no provider. With it, Connect
# deep-links into MetaMask (or any WalletConnect wallet) on the same phone.
# It is a public value, safe in the build; set it at build time.
# VITE_WALLETCONNECT_PROJECT_ID=

# ── scripts/ · agent/ · indexer/ only. NEVER commit .env ──
# A funded Shannon key: STT for gas (faucet topic in the hackathon Telegram) and
# tUSDC (public faucet: `npx tsx scripts/tap.ts faucet`).
PRIVATE_KEY=0x...
