# WalletConnect project id (Reown dashboard, project "Tapflow").
#
# Public by design: it ships inside the client bundle of every dapp that uses
# WalletConnect, so it is committed here to keep builds reproducible rather than
# living in someone's shell history. Restrict it by domain in the Reown
# dashboard, not by hiding it.
#
# Without this, the app connects only to an injected wallet, which means the
# Connect button cannot work inside a Telegram mini-app.
VITE_WALLETCONNECT_PROJECT_ID=2e99f945bb9d1b9f4677a85e095b085d
