# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456:ABC...

# Optional: a funded Shannon key the bot taps with on /up and /down.
# Unset = read-only bot that points people to the mini-app. NEVER commit .env.
# BOT_PRIVATE_KEY=0x...

# Where the TapFlow web app lives (Telegram web_app buttons need https;
# an http URL is sent as a plain link instead).
WEBAPP_URL=https://tapflow.vercel.app

# The TapFlow indexer (F4) for /board and /follow
TAPFLOW_API=http://localhost:8787

# Somnia Shannon defaults (see docs/CONTRACTS.md) — override only if needed
# RPC_URL=https://dream-rpc.somnia.network
# WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Max tUSDC per /up or /down
MAX_STAKE=25
